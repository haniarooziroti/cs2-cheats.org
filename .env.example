# For a preview host (e.g. Cloudflare Workers): set to that origin so indexing matches the live URL.
# PUBLIC_SITE_ORIGIN=https://your-subdomain.workers.dev

# Homepage “Join Discord” button — use your permanent server invite URL.
# PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
