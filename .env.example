# Build output always uses https://cs2-cheats.org for sitemap, RSS, and Astro `site`.
# If PUBLIC_SITE_ORIGIN contains workers.dev, the build throws instead of emitting that host.
# Preview hosts get noindex via public/_headers.

# Homepage “Join Discord” button — use your permanent server invite URL.
# PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
