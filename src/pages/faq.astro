---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo, canonicalUrl } from '../config/seo';
import ShareButtons from '../components/ShareButtons.astro';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];

const faqs = getAllFaqs();
const shareUrl = canonicalUrl('/faq/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: 'FAQ | CS2 cheats, loader & checkout',
      description:
        'Answers about Counter-Strike 2 cheat tiers, ESP, aimbot, HWID tools, articles, and checkout through the linked store.',
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <SiteFaqSection items={faqs} variant="full" titleId="faq-page-title" titleLevel="h1" />

  <div class="mx-auto max-w-6xl px-5 pb-12">
    <ShareButtons shareUrl={shareUrl} shareText={seo.title} />
  </div>
</BaseLayout>
