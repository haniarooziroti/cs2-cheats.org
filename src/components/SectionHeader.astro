---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
  wide?: boolean;
  /** Default h2 so marketing pages keep a single h1 in the hero; set h1 for standalone pages like FAQ. */
  titleLevel?: 'h1' | 'h2';
}

const { eyebrow, title, desc, titleId, centered = false, wide = false, titleLevel = 'h2' } = Astro.props;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  {titleLevel === 'h1' ? (
    <h1 id={titleId} class="section-header__title">{title}</h1>
  ) : (
    <h2 id={titleId} class="section-header__title">{title}</h2>
  )}
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
