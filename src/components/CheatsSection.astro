---
import '../styles/product-cheat-page.css';
import { t } from '../i18n';
import { cheatTierIcons } from '../data/sectionIcons';
import { checkoutForSlug } from '../config/checkout';
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
import type { IconName } from './icons/types';

const s = t.cheats;
const buyUrl = checkoutForSlug('cs2-store');

function tierIcon(name: string): IconName {
  return cheatTierIcons[name] ?? 'crosshair';
}
---

<section id="cheats" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="cheats-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="cheats-title" />
    <AffiliateDisclosure class="mt-4 max-w-2xl" />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        s.items.map((tier) => (
          <CatalogCard
            label={tier.tier}
            title={tier.title}
            href={tier.href}
            buyUrl={buyUrl}
            features={tier.features}
            more={tier.more}
            icon={tierIcon(tier.name)}
            badge={tier.badge}
            variant={tier.variant}
            extraBadges={tier.extraBadges}
            buyLabel="Checkout"
            viewLabel={`Open ${tier.title}`}
            maxFeatures={5}
          />
        ))
      }
    </div>
  </div>
</section>
