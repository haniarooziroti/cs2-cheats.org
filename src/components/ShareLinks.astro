---
import Icon from './icons/Icon.astro';

interface Props {
  /** Absolute page URL (production canonical). */
  url: string;
  title: string;
  class?: string;
}

const { url, title, class: className } = Astro.props;
const encUrl = encodeURIComponent(url);
const encText = encodeURIComponent(title);
const redditTitle = encodeURIComponent(title.slice(0, 120));

const links = [
  {
    label: 'Share on X',
    href: `https://twitter.com/intent/tweet?url=${encUrl}&text=${encText}`,
  },
  {
    label: 'Share on Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encUrl}`,
  },
  {
    label: 'Share on Telegram',
    href: `https://t.me/share/url?url=${encUrl}&text=${encText}`,
  },
  {
    label: 'Post to Reddit',
    href: `https://www.reddit.com/submit?url=${encUrl}&title=${redditTitle}`,
  },
  {
    label: 'Share on WhatsApp',
    href: `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`,
  },
] as const;
---

<section
  class:list={[
    'share-links mt-10 rounded-xl border border-border/80 bg-muted/20 p-4 md:p-5',
    className,
  ]}
  aria-labelledby="share-links-heading"
>
  <h2 id="share-links-heading" class="mb-3 flex items-center gap-2 text-sm font-semibold text-foreground">
    <Icon name="arrowUpRight" size={16} class="text-primary" aria-hidden="true" />
    Share this page
  </h2>
  <ul class="flex flex-wrap gap-2">
    {
      links.map((item) => (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-lg border border-border bg-background px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-primary/40 hover:text-primary"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
